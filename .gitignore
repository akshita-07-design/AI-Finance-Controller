__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/
.env

# Keep the data/ and results/ folder structure, but don't commit large
# regenerable outputs by accident until you decide what's worth committing
data/dev/*.csv
data/dev/*.json
data/test/*.csv
data/test/*.json
!data/dev/.gitkeep
!data/test/.gitkeep

# LLM response caches are pure API-cost savings, regenerable from the same
# prompts, and not meaningful evidence on their own — never commit these.
# The scorecard files (results/*_scorecard.json) ARE meaningful evidence
# and should be committed deliberately when ready to showcase real results.
results/*_llm_cache.json
results/*_ablation_cache.json
